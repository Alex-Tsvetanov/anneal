# --- LaTeX -----------------------------------------------------------------
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz

# latexmk writes everything under docs/build (see docs/latexmkrc).
# The finished PDF is the deliverable, so it is versioned with its source.
docs/build/*
!docs/build/Main.pdf

# Generated from measurement output, regenerated by the results scripts. The two
# slot files below are the exception: preamble.tex inputs them unconditionally, so
# they are versioned empty and the build works on a fresh clone.
docs/generated/*
!docs/generated/board_macros.tex
!docs/generated/gif_frames.tex

# --- C++ / CMake -----------------------------------------------------------
# Anchored to the root: a bare `build/` would also swallow docs/build, and git
# cannot re-include a file whose parent directory is excluded, so the negation
# above for docs/build/Main.pdf would silently stop working.
/build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
compile_commands.json
install_manifest.txt
_deps/
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.gcda
*.gcno
*.gcov
*.profraw
*.profdata

# --- Measurement artefacts -------------------------------------------------
# Raw benchmark and profiler output. Large, machine specific, regenerated by
# rerunning the measurements. The summarised tables in docs/ are what is kept.
results/
perf.data
perf.data.old
*.vtune
*.qdrep

# Vendored published instances (e.g. data/berlin52.tsp) are kept in-tree.
# Large downloaded archives, if any, would go under data/instances/ and stay untracked.
data/instances/

# --- Editors and OS --------------------------------------------------------
.vscode/
.idea/
.cache/
.DS_Store
Thumbs.db
